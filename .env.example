# Puerto en el que escucha el backend dentro del contenedor y en el host
# (docker-compose lo mapea como "${PORT}:4000").
PORT=4000

# development | production — Docker ya lo fija en cada compose file
# (docker-compose.dev.yml / docker-compose.yml); normalmente no hace falta
# tocarlo acá.
NODE_ENV=development

# Conexión a Postgres (src/db/prisma.ts). El valor de abajo apunta a
# localhost:5432 para correr fuera de Docker; docker-compose.dev.yml la
# sobreescribe para apuntar al servicio "db" de su propia red.
DATABASE_URL=postgresql://paymyloan:paymyloan@localhost:5432/paymyloan?schema=public

# ---------------------------------------------------------------------------
# Reservadas para etapas futuras. Todavía NO se leen en ningún lado del
# código: se documentan acá para que la forma final del .env no sorprenda
# cuando se implemente cada pieza. No descomentar hasta ese momento.
# ---------------------------------------------------------------------------

# Autenticación (cuando se agregue el flujo de auth).
# JWT_SECRET=

# Origen(es) permitido(s) para CORS, para cuando el frontend paymyloan
# empiece a consumir esta API directamente.
# CORS_ORIGIN=http://localhost:3000
