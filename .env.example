# Puerto en el que escucha el backend dentro del contenedor y en el host
# (docker-compose lo mapea como "${PORT}:4000").
PORT=4000

# development | production | test — Docker ya lo fija en cada compose file
# (docker-compose.dev.yml / docker-compose.yml); normalmente no hace falta
# tocarlo acá.
NODE_ENV=development

# Conexión a Postgres (src/db/prisma.ts). El valor de abajo apunta a
# localhost:5432 para correr fuera de Docker; docker-compose.dev.yml la
# sobreescribe para apuntar al servicio "db" de su propia red.
DATABASE_URL=postgresql://paymyloan:paymyloan@localhost:5432/paymyloan?schema=public

# ---------------------------------------------------------------------------
# Autenticación (src/config/env.ts, src/auth/). JWT_ACCESS_SECRET y
# JWT_REFRESH_SECRET son obligatorias en NODE_ENV=production — el proceso no
# arranca sin ellas (ver assertRequiredInProduction en env.ts). En desarrollo
# se usa un placeholder inseguro si se dejan vacías.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# Origen permitido para CORS — el dominio del frontend que consume esta API.
CORS_ORIGIN=http://localhost:3000

# Emisor mostrado en la app autenticadora al activar 2FA (obligatorio para
# ADMIN y LENDER).
TOTP_ISSUER=PayMyLoan

# D-P4-4: interruptor temporal para probar el resto de la API sin tener que
# activar 2FA en cada usuario de prueba. Seguro por default (exigido salvo
# que se ponga "false" acá) — nunca se toca en producción. Sacar del todo
# cuando se retome el flujo de pruebas con 2FA obligatorio de verdad.
REQUIRE_TWO_FACTOR=true

# ---------------------------------------------------------------------------
# Correo transaccional (src/lib/email.ts) — Resend.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=servicing@paymyloan.ai

# Rate limiting en /api/auth/login, /login/2fa, /password/forgot.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Suscripciones (Docs/plan/18-suscripciones.md). Precio fijo para todos los
# Borrowers; BILLING_MODE=simulated registra el pago sin pasarela (etapa 1).
# ---------------------------------------------------------------------------
SUBSCRIPTION_PRICE_CENTS=900
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_CURRENCY=usd
BILLING_MODE=simulated

# ---------------------------------------------------------------------------
# Afiliados (Docs/plan/19-afiliados.md). AFFILIATE_APPROVAL_MODE=admin|self.
# Valor por defecto 0 = sin comisión hasta que el Admin defina la tarifa.
# ---------------------------------------------------------------------------
AFFILIATE_APPROVAL_MODE=admin
AFFILIATE_DEFAULT_COMMISSION_TYPE=PERCENT
AFFILIATE_DEFAULT_COMMISSION_VALUE=0
AFFILIATE_DEFAULT_PAYOUT_DELAY_DAYS=

# En NODE_ENV=production el cobro simulado (POST /api/subscription/me/pay) responde 403
# salvo que se active a propósito (p. ej. un staging). Sin pasarela real, cualquier
# Borrower podría "pagar" gratis y generar comisiones de afiliado.
ALLOW_SIMULATED_BILLING=false
