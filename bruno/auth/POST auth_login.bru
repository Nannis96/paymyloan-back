meta {
  name: POST /auth/login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@paymyloan.dev",
    "password": "DevPass!2026"
