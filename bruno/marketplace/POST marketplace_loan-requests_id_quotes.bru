meta {
  name: POST /marketplace/loan-requests/:id/quotes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/marketplace/loan-requests/:id/quotes
  body: json
  auth: inherit
}

params:path {
  id: {{loanRequestId}}
}

body:json {
  {
    "structure": "INTEREST_ONLY",
    "principalAmount": 1,
    "interestRate": 0,
    "amortizationTermMonths": 1
  }
}
