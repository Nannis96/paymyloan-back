meta {
  name: POST /borrowers/me/loan-requests
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/borrowers/me/loan-requests
  body: json
  auth: inherit
}

body:json {
  {
    "property": {
      "addressLine1": "addressLine1",
      "city": "city",
      "state": "TX",
      "postalCode": "postalCode",
      "propertyType": "SINGLE_FAMILY"
    },
    "projectType": "RENTAL",
    "purchasePrice": 1,
    "rehabAmount": 0,
    "totalLoanAmountRequested": 1,
    "requestedClosingDate": "2026-09-30",
    "visibility": "PUBLIC"
  }
}

script:post-response {
  if (res.body?.data?.id) bru.setEnvVar("loanRequestId", res.body.data.id);
}
