generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ver alcance §3 y §7: el rol de negocio (Lender / Borrower / Viewer) no vive
// acá — vive en la relación persona ↔ préstamo (LoanParty, todavía no
// modelada). User es solo identidad, credenciales y 2FA.
model User {
  // UUIDv7 nativo de Postgres (BE-001, decisión D0-2): ordenable por tiempo
  // de creación como un autoincrement, pero no adivinable/enumerable como
  // un ID secuencial. Convención para toda tabla nueva del proyecto.
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name     String
  email    String @unique
  password String // hash bcrypt, nunca texto plano

  twoFactorSecret    String?
  isTwoFactorEnabled Boolean @default(false)

  // Eliminado lógico: un usuario nunca se borra físicamente (puede quedar
  // referenciado desde préstamos, documentos o la bitácora). "Eliminar" acá
  // significa apagar el acceso, no borrar el registro.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
